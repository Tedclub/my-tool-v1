{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "taiwan-market-scanner",
  "main": "src/index.js",
  "compatibility_date": "2026-09-29",
  "workers_dev": true,
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },
  "assets": {
    "directory": "./public/",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*", "/admin/*", "/health"]
  },
  "triggers": {
    "crons": ["0 9 * * *"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "taiwan-market-data",
      "database_id": "40b89ca6-9f60-4bd3-b63b-3204482e6852"
    }
  ]
}
