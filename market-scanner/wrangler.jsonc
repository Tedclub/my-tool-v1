{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "taiwan-market-scanner",
  "main": "src/index.js",
  "compatibility_date": "2026-09-29",
  "workers_dev": true,\n  "observability": {\n    "enabled": true,\n    "head_sampling_rate": 1\n  },
  "triggers": {
    "crons": ["*/5 * * * *", "0 9 * * *"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "taiwan-market-data",
      "database_id": "40b89ca6-9f60-4bd3-b63b-3204482e6852"
    }
  ]
}
